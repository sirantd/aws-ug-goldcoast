---
import { Image } from 'astro:assets';

import { site } from '../data/site';
import { getNews } from '../lib/events';
import { hasGallery } from '../lib/gallery';
import badge from '../assets/brand/hex-badge.png';

/** Anchors point at home-page sections, so off-home pages need the `/` prefix. */
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const base = isHome ? '' : '/';

/** News and Gallery hide themselves when empty; their anchors must follow suit. */
const hasNews = (await getNews()).length > 0;

const links = [
  { label: 'Events', href: `${base}#events`, show: true },
  { label: 'News', href: `${base}#news`, show: hasNews },
  { label: 'About', href: `${base}#about`, show: true },
  { label: 'Gallery', href: `${base}#gallery`, show: hasGallery },
  { label: 'Speak', href: `${base}#speak`, show: true },
].filter((link) => link.show);
---

<nav class="nav" aria-label="Primary">
  <div class="nav__inner">
    <a class="nav__brand" href="/">
      <Image src={badge} alt={`${site.name} logo`} width={88} densities={[1, 2]} />
      <span>AWS User Group <em>Gold Coast</em></span>
    </a>

    <details class="nav__menu">
      <summary class="nav__toggle">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
          <path d="M3 6h18v2H3V6Zm0 5h18v2H3v-2Zm0 5h18v2H3v-2Z"></path>
        </svg>
        Menu
      </summary>
      <div class="nav__links">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
        <a class="btn btn--gold btn--sm" href={site.rsvpUrl} target="_blank" rel="noopener">
          RSVP on Luma
        </a>
      </div>
    </details>
  </div>
</nav>

<script>
  // Close the mobile disclosure menu once a link inside it is followed, and on
  // outside clicks or Escape. Progressive enhancement — the menu opens and
  // closes without this.
  const menu = document.querySelector<HTMLDetailsElement>('.nav__menu');

  if (menu) {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('.nav__links a')) menu.open = false;
    });

    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.open = false;
    });
  }
</script>
